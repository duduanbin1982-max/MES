# ============================================
#  工厂 MES .gitignore
#  Author: 三狗子 | Date: 2026-06-24
# ============================================

# 依赖
node_modules/
package-lock.json.bak

# 运行时数据 (数据库, 日志, 测试产物)
data/*.db
data/*.db-*
data/*.log
data/*.log.*
data/*.gz
data/predeploy-*.log
data/nightly-test.log
data/seed-xsub.json
data/mes.log
!data/.gitkeep

# 数据库备份目录 (按时间戳命名, 一律不进库)
backups/
.codex-backups/

# nginx 模板配置入库；SSL 私钥/证书不入库
/nginx/*
!/nginx/
!/nginx/factory-mes.conf
ssl/

# 前端构建产物 (build 时生成, 不入库)
frontend/dist/
# npm run build:safe 的中间目录 (失败时也不会破坏现有 dist)
frontend/dist.next/
frontend/dist.prev/

# backups / 临时备份
*.bak
*.bak.*
server.js.bak.*
*.swp
*.swo

# tmp
.tmp/
*.tmp
/tmp/seed-xsub.json
/tmp/xsub-*/

# env (含密码/密钥)
.env
.env.local
.env.*.local

# tooling caches
.brooks-lint-history.json
.brooks-lint.yaml
.cache/

# editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# coverage
/coverage/
/.nyc_output/

# 锁文件: 留 package-lock.json 不忽略, 保证依赖可复现
# db migration 废弃/历史副本 (中文后缀)
db/migrations/*.废弃
db/migrations/*.bak

# archive / root debug leftovers
archive/
*.bak-*
/.tmp_*
/_check_*
/*_probe.js
/_schema_probe.*
/test-h2.js
/test-nginx.js
/testws2.sh

# runtime uploads / generated databases / logs
data/uploads/
data/mes.db*
logs/

# root one-off maintenance/debug scripts
/_*.js
/mes.db

# 废弃/占位数据库标记 (0 字节哨兵文件, 防止误连旧库)
*.stale-do-not-use

# 根目录一次性维护脚本的临时变体 (scripts/check-* 为正式脚本, 不受影响)
/check_*.js

# ESLint 落地时的一次性快照与临时目录（2026-10-17）
node_modules.before-lint/
*.before-lint
.tmp/
