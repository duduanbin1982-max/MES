# TBM-MES v2.1 环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略

NODE_ENV=production

# JWT HMAC 签名密钥（生产必须用 openssl rand -hex 64 生成；切勿提交）
# 示例：JWT_SECRET=$(openssl rand -hex 64)
JWT_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRE_HOURS=24

# 登录限流
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# 飞书机器人 webhook（不配置则飞书通知返回 ok:false，不静默失败）
# 填完整 URL 或仅 token
FEISHU_WEBHOOK_TOKEN=
FEISHU_WEBHOOK_TIMEOUT_MS=3000

# IoT 采集器
# IOT_MODE=simulator 时每 5s 采集一轮；生产由 systemd drop-in 固定为 production。
# 周期性采集日志默认静默（一天约 1.7 万行），排障时临时置 1。
IOT_VERBOSE=0

# 报警去重冷却窗口（分钟，1~1440，默认 30）
IOT_ALARM_COOLDOWN_MINUTES=30

# 模拟器造报警的概率（0~1，默认 0.0002；演示环境可调大）
IOT_SIM_ALARM_RATE=0.0002
