{
  "name": "factory-mes",
  "version": "0.1.0",
  "description": "盾构机 MES - Phase 1",
  "main": "server.js",
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=high",
  "audit:modules": "node scripts/audit-modules-sweep.js",
    "backfill": "node scripts/data-backfill.js",
    "backfill:report": "node scripts/data-backfill.js --report",
    "backfill:template": "node scripts/gen-backfill-templates.js",
    "backfill:test": "node --test tests/dataBackfill.test.js",
    "boundary:check": "node scripts/check-module-boundaries.js",
    "boundary:json": "node scripts/check-module-boundaries.js --json",
    "check:layers": "node scripts/check-layer-boundaries.js",
    "check:modules": "node scripts/check-module-manifest.js",
    "check:routes": "node scripts/check-duplicate-routes.js",
    "dev": "node server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "mcp": "node scripts/mcp-server.js",
    "mcp:test": "node --test tests/mcpServer.test.js",
    "migrate": "node migrate.js",
    "acceptance:e2e": "node scripts/acceptance-e2e.js",
  "acceptance:e2e:reset": "node scripts/acceptance-e2e.js --reset",
  "acceptance:e2e:keep": "node scripts/acceptance-e2e.js --keep",
  "acceptance:health": "node scripts/acceptance-e2e.js --health",
  "acceptance:purchase": "node scripts/acceptance-purchase-chain.js",
  "acceptance:material": "node scripts/acceptance-material-chain.js",
  "predeploy": "bash scripts/pre-deploy-test.sh",
    "schema:check": "node scripts/check-service-schema-versions.js",
    "schema:write": "node scripts/check-service-schema-versions.js --write",
    "start": "node server.js",
    "test": "bash scripts/run-all-tests.sh",
    "test:all": "bash scripts/run-all-tests.sh",
    "test:integration": "node tests/processTreeCrossSubsystemDeps.integration.test.js",
    "test:unit": "node --test tests/processNodeSubsystem.test.js tests/processTreeCrossSubsystemDeps.test.js tests/processTreeMindmap.test.js tests/utils-partno.test.js tests/keyComponentPrices.test.js tests/costRollup.test.js tests/materialPrices.test.js tests/materialService.test.js tests/purchase.test.js tests/delayAlerts.test.js tests/processParams.test.js tests/oee.test.js tests/scheduler.test.js tests/dashboardRiskSummary.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pino": "^10.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
