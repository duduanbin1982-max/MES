#!/bin/bash
# .githooks/pre-commit
# commit 前跑测试闸门 (含 167 个测试 + 语法体检, 约 0.7s)
# 失败: 阻止 commit
# 跳过: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] 跑测试闸门 ..."
bash scripts/pre-deploy-test.sh --quiet
RC=$?
if [ "$RC" -ne 0 ]; then
  echo ""
  echo "❌ pre-commit: 测试失败, commit 被阻止"
  echo "   跳过: git commit --no-verify (不推荐)"
  exit 1
fi
echo "[pre-commit] ✅ 通过"