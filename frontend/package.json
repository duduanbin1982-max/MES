{
  "name": "tbm-mes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3891",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:domain": "node --test tests/domain/*.test.ts",
    "build:safe": "vite build --outDir dist.next --emptyOutDir && rm -rf dist.prev && (mv dist dist.prev 2>/dev/null || true) && mv dist.next dist && rm -rf dist.prev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.7.0",
    "pinia": "^2.1.7",
    "three": "^0.185.1",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.7",
    "vue-tsc": "^2.0.0"
  }
}
