[Unit]
Description=Factory MES (TBM Phase 1)
After=network.target

[Service]
Type=simple
Environment="PATH=/home/dubin/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="NODE_ENV=production"
WorkingDirectory=/home/dubin/factory-mes
ExecStartPre=/bin/bash /home/dubin/factory-mes/scripts/pre-deploy-test.sh --quiet
ExecStart=/home/dubin/.nvm/versions/node/v22.22.3/bin/node server.js
Restart=on-failure
RestartSec=5s
StandardOutput=append:/home/dubin/factory-mes/logs/mes.log
StandardError=append:/home/dubin/factory-mes/logs/mes.log

[Install]
WantedBy=default.target
